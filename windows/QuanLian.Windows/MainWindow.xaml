<Window x:Class="QuanLian.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小李全联" Width="1180" Height="760" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#EAF2FF" Padding="22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,18,0,34">
          <Border Width="76" Height="76" CornerRadius="24" Background="#DCEAFF" HorizontalAlignment="Center"><TextBlock Text="↔" FontSize="48" Foreground="#2878E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="小李全联" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
          <TextBlock Text="设备互联 · 极速传输" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel>
          <Button Content="  接收文件" Height="52" Margin="0,4" Background="#DCE9FF" Foreground="#2878E8" FontSize="16" BorderThickness="0"/>
          <Button Content="  发送文件" Height="52" Margin="0,4" Background="Transparent" Foreground="#52627D" FontSize="16" BorderThickness="0"/>
          <Button Content="  传输记录" Height="52" Margin="0,4" Background="Transparent" Foreground="#52627D" FontSize="16" BorderThickness="0"/>
          <Button Content="  设置" Height="52" Margin="0,4" Background="Transparent" Foreground="#52627D" FontSize="16" BorderThickness="0"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="局域网直连 · 无广告" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,12"/>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="42,34,42,36">
        <TextBlock Text="接收文件" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="让附近设备直接向这台电脑发送文件" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,5,0,26"/>
        <Border Background="White" CornerRadius="22" Padding="28" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="本机接收状态" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="ReceiveStatus" Text="正在初始化局域网服务…" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
            <TextBlock x:Name="DeviceIdentityText" Text="设备：正在初始化" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="White" CornerRadius="22" Padding="28">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock Text="附近设备" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock x:Name="DeviceCount" Text="发现 0 台设备" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="EmptyDevices" Text="正在搜索附近的小李全联设备…" Foreground="{StaticResource Muted}" Margin="0,8,0,8"/>
            <ItemsControl x:Name="DevicesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#F5F8FF" CornerRadius="14" Padding="16" Margin="0,5">
                    <DockPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="{Binding Host}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <TextBlock Text="已发现" Foreground="#2878E8" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
