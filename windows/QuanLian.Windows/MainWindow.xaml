<Window x:Class="QuanLian.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小李全联" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Height" Value="58"/><Setter Property="Margin" Value="0,5"/>
      <Setter Property="Padding" Value="18,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#60708C"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E3EDFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#D5E5FF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FeatureCard" TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Card" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}">
          <Border.Effect><DropShadowEffect Color="#243B66" BlurRadius="22" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F7FAFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF4FF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#EAF2FF" Padding="22">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,18,0,42">
          <Border Width="78" Height="78" CornerRadius="25" Background="#DCEAFF" HorizontalAlignment="Center">
            <TextBlock Text="↔" FontSize="50" FontWeight="Light" Foreground="#2878E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="小李全联" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,15,0,5"/>
          <TextBlock Text="设备互联 · 极速传输" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
          <Button x:Name="ReceiveNav" Style="{StaticResource NavButton}" Content="  ◉   接收文件" Background="#D8E7FF" Foreground="#2878E8" Click="ReceiveNav_Click"/>
          <Button x:Name="SendNav" Style="{StaticResource NavButton}" Content="  ⇧   发送文件" Click="SendNav_Click"/>
          <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Content="  ◷   传输记录" Click="HistoryNav_Click"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="  ⚙   设置" Click="SettingsNav_Click"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#DFEAFC" CornerRadius="14" Padding="12" Margin="0,12,0,4">
          <TextBlock Text="局域网直连  ·  无广告" Foreground="#7184A3" FontSize="12" HorizontalAlignment="Center"/>
        </Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,26,34,28">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="ReceivePage">
            <Grid Margin="4,0,4,24">
              <StackPanel><TextBlock Text="接收文件" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="让附近设备直接向这台电脑发送文件" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E5F7EF" CornerRadius="18" Padding="14,8"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#22B879" Margin="0,0,8,0"/><TextBlock Text="接收服务待完善" Foreground="#239568" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
            <Border Background="White" CornerRadius="24" Padding="26" Margin="0,0,0,20">
              <Border.Effect><DropShadowEffect Color="#243B66" BlurRadius="24" ShadowDepth="3" Opacity="0.06"/></Border.Effect>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,8,24,8">
                  <TextBlock Text="本机接收状态" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                  <TextBlock x:Name="ReceiveStatus" Text="正在初始化局域网服务…" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,15,0,0"/>
                  <TextBlock x:Name="DeviceIdentityText" Text="设备：正在初始化" FontSize="13" Foreground="#71809A" Margin="0,12,0,0"/>
                  <Border Background="#F2F7FF" CornerRadius="12" Padding="12" Margin="0,18,0,0"><TextBlock Text="请保持小李全联运行，并确保设备连接同一局域网" Foreground="#6F83A5" FontSize="12" TextWrapping="Wrap"/></Border>
                </StackPanel>
                <Border Grid.Column="1" Background="#F3F8FF" CornerRadius="20" MinHeight="220" Padding="20">
                  <Grid>
                    <Ellipse Width="168" Height="168" Stroke="#D7E7FF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="132" Height="132" Fill="#E5F0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="96" Height="96" Fill="#D3E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="⇩" FontSize="64" FontWeight="Light" Foreground="#2878E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Background="White" CornerRadius="12" Padding="10,7" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="等待文件到达" Foreground="#2878E8" FontSize="12" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="安全连接 · 稳定接收" Foreground="#8293AF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                  </Grid>
                </Border>
              </Grid>
            </Border>
            <Border Background="White" CornerRadius="24" Padding="26">
              <Border.Effect><DropShadowEffect Color="#243B66" BlurRadius="24" ShadowDepth="3" Opacity="0.06"/></Border.Effect>
              <StackPanel>
                <DockPanel Margin="0,0,0,16"><TextBlock Text="附近设备" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="DeviceCount" Text="发现 0 台设备" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
                <Border Background="#F5F8FF" CornerRadius="16" Padding="18" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="25" Foreground="#4386E8" Margin="0,0,12,0"/><TextBlock x:Name="EmptyDevices" Text="正在搜索附近的小李全联设备…" Foreground="#8291AA" VerticalAlignment="Center" FontSize="14"/></StackPanel></Border>
                <ItemsControl x:Name="DevicesList">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="#F5F8FF" CornerRadius="15" Padding="17" Margin="0,5"><DockPanel>
                      <Border Width="44" Height="44" Background="#E1EDFF" CornerRadius="13" Margin="0,0,14,0"><TextBlock Text="▣" FontSize="22" Foreground="#2878E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Ink}"/><TextBlock Text="{Binding Host}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                      <TextBlock Text="已发现" Foreground="#2878E8" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    </DockPanel></Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="SendPage" Visibility="Collapsed">
            <TextBlock Text="发送文件" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="选择要发送的内容，快速传输到附近设备" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,6,0,24"/>
            <UniformGrid Columns="3" Rows="2" Margin="-8,0,-8,20">
              <Button Style="{StaticResource FeatureCard}" Click="SendFiles_Click" Tag="file"><StackPanel><TextBlock Text="▧" FontSize="34" Foreground="#3985EA"/><TextBlock Text="文件" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,18,0,5"/><TextBlock Text="发送文档、压缩包及其他文件" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Button>
              <Button Style="{StaticResource FeatureCard}" Click="SendFiles_Click" Tag="image"><StackPanel><TextBlock Text="▣" FontSize="34" Foreground="#3985EA"/><TextBlock Text="图片" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,18,0,5"/><TextBlock Text="选择照片与图片进行传输" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Button>
              <Button Style="{StaticResource FeatureCard}" Click="SendFiles_Click" Tag="media"><StackPanel><TextBlock Text="♫" FontSize="34" Foreground="#3985EA"/><TextBlock Text="媒体" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,18,0,5"/><TextBlock Text="发送视频、音频等媒体内容" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Button>
              <Button Style="{StaticResource FeatureCard}" Click="SendFiles_Click" Tag="text"><StackPanel><TextBlock Text="▤" FontSize="34" Foreground="#3985EA"/><TextBlock Text="文本" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,18,0,5"/><TextBlock Text="发送文字内容与消息" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Button>
              <Button Style="{StaticResource FeatureCard}" Click="SendFiles_Click" Tag="folder"><StackPanel><TextBlock Text="▱" FontSize="34" Foreground="#3985EA"/><TextBlock Text="文件夹" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,18,0,5"/><TextBlock Text="选择整个文件夹批量发送" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Button>
              <Button Style="{StaticResource FeatureCard}" Click="SendFiles_Click" Tag="app"><StackPanel><TextBlock Text="▦" FontSize="34" Foreground="#3985EA"/><TextBlock Text="应用" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,18,0,5"/><TextBlock Text="分享已安装的应用程序" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Button>
            </UniformGrid>
            <Border Background="White" CornerRadius="22" Padding="24"><StackPanel><DockPanel><TextBlock Text="附近设备" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="选择接收设备" Foreground="{StaticResource Muted}" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="设备发现服务正在运行，发送传输功能正在接入。" Foreground="{StaticResource Muted}" Margin="0,16,0,4"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="OtherPage" Visibility="Collapsed">
            <TextBlock x:Name="OtherPageTitle" Text="传输记录" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <Border Background="White" CornerRadius="24" Padding="30" Margin="0,24,0,0"><TextBlock Text="此页面将沿用电视横屏版的蓝白科技风布局。" FontSize="15" Foreground="{StaticResource Muted}"/></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>